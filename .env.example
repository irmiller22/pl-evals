# make serve loads .env if present. Never commit real credentials.
# Set an exact Anthropic API model ID; an optional anthropic/ prefix is accepted.
# Examples (verify current availability in your Anthropic account):
#   claude-sonnet-5                 balanced starting baseline
#   claude-haiku-4-5-20251001       faster, lower-cost comparison model
#   claude-opus-4-8                 stronger, higher-cost comparison model
# These are Claude API IDs. Bedrock-style IDs are not supported by this adapter.
APP_MODEL=
# APP_MODEL falls back to BASELINE_MODEL when empty.
BASELINE_MODEL=
CANDIDATE_MODEL=
JUDGE_MODEL=
ANTHROPIC_API_KEY=

# OpenAI Responses API configuration. Use this when selecting an OpenAI model.
#   gpt-5.4       flagship comparison model
#   gpt-5-mini    faster, lower-cost comparison model
#   gpt-5-nano    fastest, lowest-cost comparison model
OPENAI_API_KEY=
OPENAI_MODEL=
